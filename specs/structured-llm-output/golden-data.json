    {
      "id": "GD-SLO-009",
      "name": "ScreenerService parity — natural language to nested {filters, explanation} dict (REAL contract)",
      "requirement": "REQ-SLO-008",
      "corrected_in": "BB1 Phase 3 PR-C (golden-data v1.2) — original Phase 1 scenario assumed a flat filter dict; the actual ScreenerService.parse_with_claude returns nested shape per ScreenerService/screener_ai.py:128",
      "input": {
        "adapter": "parse_with_claude",
        "schema": "ScreenerResponse",
        "prompt": "small cap value stocks under $5B with PE under 12 in financial sector"
      },
      "provider_response": {
        "type": "tool_use",
        "id": "toolu_08VWX",
        "name": "ScreenerResponse",
        "input": {
          "filters": {
            "minMarketCap": "300000000",
            "maxPE": 12.0,
            "sector": "Financial Services"
          },
          "explanation": [
            "Small cap = minMarketCap of $300M",
            "PE under 12 → maxPE: 12",
            "Financial sector → sector: Financial Services"
          ]
        }
      },
      "expected_legacy_dict": {
        "filters": {
          "minMarketCap": "300000000",
          "maxPE": 12.0,
          "sector": "Financial Services"
        },
        "explanation": [
          "Small cap = minMarketCap of $300M",
          "PE under 12 → maxPE: 12",
          "Financial sector → sector: Financial Services"
        ]
      },
      "notes": "ScreenerResponse is a MarkdownRenderable wrapping nested ScreenerFilters + explanation list. minMarketCap and minVolume are returned as strings (existing contract); ScreenerService preserves its numeric→string post-processing for these two fields."
    },
    {
      "id": "GD-SLO-010",
      "name": "Markdown round-trip — ScreenerFilter to markdown is stable and human-readable",
      "requirement": "REQ-SLO-005",
      "input": {
        "schema": "ScreenerFilter",
        "instance": {
          "market_cap_max": 20000000000,
          "sector": ["Technology"],
          "pe_max": 15.0
        }
      },
      "expected_markdown": "**Filter**\n- Sector: Technology\n- Market cap: ≤ $20.0B\n- P/E: ≤ 15.0",
      "notes": "Each schema decides its own markdown shape — library only enforces the to_markdown contract exists. Test asserts exact string equality to lock the format."
    },
    {
      "id": "GD-SLO-011",
      "name": "Anthropic API error (rate limit) propagates with provider context",
      "requirement": "REQ-SLO-001",
      "input": {
        "provider": "anthropic",
        "llm_model": "claude-haiku-4-5-20251001",
        "schema": "ScreenerFilter",
        "prompt": "any query"
      },
      "provider_error": {
        "type": "RateLimitError",
        "status_code": 429,
        "message": "rate_limit_exceeded"
      },
      "expected_error": {
        "type": "RateLimitError",
        "context": {
          "provider": "anthropic",
          "llm_model": "claude-haiku-4-5-20251001",
          "schema_name": "ScreenerFilter"
        }
      },
      "notes": "Library does NOT swallow provider errors — caller is responsible for backoff and fallback. Library only attaches context for observability."
    },
    {
      "id": "GD-SLO-012",
      "name": "Unknown provider raises ValueError",
      "requirement": "REQ-SLO-006",
      "input": {
        "provider": "gemini",
        "llm_model": "gemini-3-pro",
        "schema": "ScreenerFilter",
        "prompt": "any"
      },
      "expected_error": {
        "type": "ValueError",
        "message_contains": "provider must be one of"
      }
    },
    {
      "id": "GD-SLO-013",
      "name": "Anthropic returns text block instead of tool_use → corrective retry succeeds",
      "requirement": "REQ-SLO-001, REQ-SLO-004",
      "added_in": "BB1 Phase 3 PR-B (per CPO follow-up M1; R-BB1-003 mitigation)",
      "input": {
        "provider": "anthropic",
        "llm_model": "claude-haiku-4-5-20251001",
        "schema": "TraderRating",
        "prompt": "Rate NVDA"
      },
      "provider_responses_in_order": [
        {
          "type": "text",
          "text": "I think NVDA is a strong buy because of AI compute demand and the Blackwell rollout. The stock has had a great run."
        },
        {
          "type": "tool_use",
          "id": "toolu_09YZA",
          "name": "TraderRating",
          "input": {
            "ticker": "NVDA",
            "rating": "Buy",
            "confidence": 0.78,
            "rationale": "Structural AI compute demand; Blackwell margin tailwind."
          }
        }
      ],
      "expected_parsed": {
        "ticker": "NVDA",
        "rating": "Buy",
        "confidence": 0.78,
        "rationale": "Structural AI compute demand; Blackwell margin tailwind."
      },
      "expected_retry_count": 1,
      "notes": "Anthropic occasionally returns a text block under load even when tool_choice forces a specific tool. Library treats this as a parse failure recoverable via single corrective retry."
    }
  ]
}
